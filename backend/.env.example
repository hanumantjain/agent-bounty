PORT=3001

HEDERA_NETWORK=testnet
HEDERA_PAY_TO_ACCOUNT_ID=

BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
# Usage-based, not flat: price = PRICE_PER_ITEM_TINYBARS x records-per-protocol x protocols
# composed (see backend/lib/graph.js). GET /api/data/pricing exposes this for an agent to
# budget against before it probes.
PRICE_PER_ITEM_TINYBARS=15000000

GRAPH_API_KEY=
GRAPH_SUBGRAPH_ID=
# Optional: query the SAME entity across multiple live Messari-standardized lending subgraphs
# (comma-separated name:subgraphId pairs) instead of just one. Falls back to GRAPH_SUBGRAPH_ID
# above as a single-protocol list if unset.
GRAPH_PROTOCOLS=
