PORT=3001

HEDERA_NETWORK=testnet
HEDERA_PAY_TO_ACCOUNT_ID=

BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
# Usage-based, not flat: price = PRICE_PER_ITEM_TINYBARS x records-per-protocol x protocols
# composed (see backend/lib/graph.js). GET /api/data/pricing exposes this for an agent to
# budget against before it probes.
PRICE_PER_ITEM_TINYBARS=15000000
# Same formula, denominated in the HTS data-credit token instead of HBAR (see
# agent/.env.example's DATA_CREDIT_TOKEN_ID) — independent of the HBAR price above since a
# token-denominated price has no reason to track tinybar scale. Units are the token's smallest
# unit (2 decimals), so 100 = 1.00 ADC.
DATA_CREDIT_PRICE_PER_ITEM=100

GRAPH_API_KEY=
GRAPH_SUBGRAPH_ID=
# Optional: query the SAME entity across multiple live Messari-standardized lending subgraphs
# (comma-separated name:subgraphId pairs) instead of just one. Falls back to GRAPH_SUBGRAPH_ID
# above as a single-protocol list if unset.
GRAPH_PROTOCOLS=

# Used by backend/lib/aiSuggest.js (bounty suggestions grounded in live subgraph data) and,
# when this process serves agent/lib/aiExplain.js's reviewer note or agent/lib/analyze.js's
# judgeAnomaly() via a dynamic import (see backend/routes/bounty.js), those too. The agent
# process itself also needs its own copy of this key directly — see agent/.env.example — since
# judgeAnomaly() is on the critical path for claiming and checking bounties, not just cosmetic.
# Billed separately from a ChatGPT subscription — needs its own API key from platform.openai.com.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
