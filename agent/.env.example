HEDERA_NETWORK=testnet

AGENT_HEDERA_ACCOUNT_ID=
AGENT_HEDERA_PRIVATE_KEY=
AGENT_HEDERA_KEY_TYPE=ECDSA

# The AGENT_HEDERA_* account above IS agentbounty.eth's own wallet — it creates bounties,
# deployed the contract, and (as the contract's immutable `verifier`) signs every reward
# release. That's a deliberate design choice, not a placeholder: the manager identity and the
# original account are the same thing.
#
# researcher/intern, below, are separate WORKER identities competing for bounties, so each gets
# its own dedicated account — a "race to claim" between them is a real race between independent
# signers, not one wallet racing itself. Falls back to the shared AGENT_HEDERA_* trio above for
# any identity left unset.
RESEARCHER_HEDERA_ACCOUNT_ID=
RESEARCHER_HEDERA_PRIVATE_KEY=
RESEARCHER_HEDERA_KEY_TYPE=
INTERN_HEDERA_ACCOUNT_ID=
INTERN_HEDERA_PRIVATE_KEY=
INTERN_HEDERA_KEY_TYPE=

BACKEND_URL=http://localhost:3001

ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_PARENT_LABEL=
ENS_SPENDING_LIMIT_KEY=agent.spending.limit
ENS_ADMIN_PRIVATE_KEY=
ENS_IDENTITY=researcher
# Optional: a genuinely separate Sepolia account (not the admin) used by
# scripts/provePolicyDelegation.js to prove Enhanced Access Control delegation is real — the
# admin grants it a role scoped to one text key, then it signs its own setText transaction.
ENS_POLICY_OPERATOR_PRIVATE_KEY=

HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
BOUNTY_CONTRACT_ADDRESS=

GRAPH_API_KEY=
GRAPH_SUBGRAPH_ID=
# Optional: query the SAME entity across multiple live Messari-standardized lending subgraphs
# (comma-separated name:subgraphId pairs) instead of just one — "one query pattern spanning
# many protocols." Falls back to GRAPH_SUBGRAPH_ID above as a single-protocol list if unset.
GRAPH_PROTOCOLS=
